OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# chat persistence -- sign up on cloud.assistant-ui.com
# NEXT_PUBLIC_ASSISTANT_BASE_URL=

# Kokoro-FastAPI (Docker) — https://github.com/remsky/Kokoro-FastAPI
# Server URL (used by Next.js proxy at /api/tts). Override for production.
KOKORO_BASE_URL=http://localhost:8880
# Exposed to browser only if you call Kokoro directly (not via /api/tts proxy).
# For production, leave empty and use the proxy route instead.
NEXT_PUBLIC_KOKORO_BASE_URL=http://localhost:8880
# Swagger UI: http://localhost:8880/docs  OpenAPI: http://localhost:8880/openapi.json
